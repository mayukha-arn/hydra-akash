# Fake placeholder values only. Copy to .env and fill in locally.
AKASH_API_KEY=your_akash_console_api_key
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_ZONE_ID=your_zone_id
DATABASE_URL=sqlite:///hydra.db
# simulate needs no keys; live creates paid deployments.
HYDRA_MODE=simulate
HYDRA_DOMAIN=app.example.com
